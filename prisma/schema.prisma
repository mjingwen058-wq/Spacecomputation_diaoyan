generator client {
  provider = "prisma-client"
  runtime  = "cloudflare"
  output   = "../generated/prisma"
}
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model Submission {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  // Part 1 - basic info
  name     String
  gender   String
  major    String
  grade    String
  campus   String
  email    String
  thoughts String @db.Text

  wantsCore Boolean

  // Branch A - regular member exploration
  interestsA    String[] @default([])
  otherInterest String?
  futureWish    String?  @db.Text

  // Branch B - core member intent (departments is stored in preference-rank order)
  departments String[] @default([])
  skills      String? @db.Text

  // deterministic seed used to regenerate this person's pixel avatar
  avatarSeed String
}
